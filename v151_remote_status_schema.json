{
  "schema_version": "v151.remote.v1",
  "required": [
    "schema_version",
    "generated_at",
    "source_generated_at",
    "remote_quote_available",
    "initial_capital",
    "total_pnl",
    "total_pnl_pct",
    "positions",
    "operation_history_2d",
    "closed_orders"
  ],
  "portfolio_fields": {
    "initial_capital": "string, default 100.00万",
    "total_pnl": "string, realized + unrealized",
    "total_pnl_pct": "string, total_pnl / initial_capital",
    "equity": "string, initial capital + total_pnl",
    "market_value": "string",
    "floating_pnl": "string",
    "realized_pnl": "string"
  },
  "positions_item": {
    "code": "string",
    "name": "string",
    "qty": "string",
    "cost": "string",
    "price": "string",
    "market_value": "string",
    "pnl_amount": "string",
    "pnl_pct": "string",
    "state": "string"
  },
  "operation_history_2d_item": {
    "date": "YYYY-MM-DD",
    "time": "HH:mm:ss",
    "type": "Chinese display label",
    "code": "string",
    "name": "string",
    "action": "Chinese display label",
    "qty": "string",
    "price": "string",
    "note": "Chinese display text"
  },
  "closed_orders_item": {
    "date": "YYYY-MM-DD",
    "time": "HH:mm:ss",
    "code": "string",
    "name": "string",
    "qty": "string",
    "buy_price": "string",
    "sell_price": "string",
    "pnl_amount": "string",
    "pnl_pct": "string",
    "reason": "Chinese display text"
  },
  "ui_rules": {
    "hide_internal_sync_errors": true,
    "hide_quote_source_details": true,
    "no_raw_internal_enums": true,
    "closed_orders_are_separate_from_operation_history": true
  }
}
